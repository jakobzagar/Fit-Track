{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.1/schemas/config.json",
    "release-type": "node",
    "include-component-in-tag": false,
    "include-v-in-tag": true,
    "pull-request-title-pattern": "chore: release ${version}",
    "changelog-sections": [
        {
            "type": "feat",
            "section": "Features"
        },
        {
            "type": "fix",
            "section": "Bug Fixes"
        },
        {
            "type": "perf",
            "section": "Performance Improvements"
        },
        {
            "type": "revert",
            "section": "Reverts"
        }
    ],
    "bootstrap-sha": "90aa67b4057f2cef832bae7705a74a8dd0b78cc9",
    "packages": {
        ".": {
            "component": "fit-track",
            "package-name": "fit-track",
            "extra-files": [
                {
                    "type": "json",
                    "path": "backend/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "frontend/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "shared/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.backend.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.frontend.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.shared.version"
                }
            ]
        }
    }
}
