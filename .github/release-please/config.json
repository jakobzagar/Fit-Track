{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.1/schemas/config.json",
    "release-type": "node",
    "packages": {
        ".": {
            "component": "fit-track",
            "package-name": "fit-track",
            "extra-files": [
                {
                    "type": "json",
                    "path": "backend/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "frontend/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "shared/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.backend.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.frontend.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.shared.version"
                }
            ]
        }
    }
}
