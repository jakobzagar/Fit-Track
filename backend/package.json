{
    "name": "@fit-track/backend",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "debug": "tsx watch --inspect=0.0.0.0:9229 src/server.ts",
        "build": "prisma generate && tsc",
        "generate": "prisma generate",
        "start": "node dist/src/server.js",
        "lint": "eslint .",
        "test": "vitest run --config vitest.unit.config.ts",
        "test:watch": "vitest --config vitest.unit.config.ts",
        "test:integration": "vitest run",
        "test:integration:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fit-track/shared": "*",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.13.2",
        "@types/pg": "^8.21.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.8.1",
        "globals": "^17.11.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.12",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    }
}
