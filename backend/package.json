{
    "name": "@fit-track/backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "debug": "tsx watch --inspect=0.0.0.0:9229 src/server.ts",
        "build": "prisma generate && tsc",
        "generate": "prisma generate",
        "start": "node dist/src/server.js",
        "lint": "eslint .",
        "test:integration": "vitest run",
        "test:integration:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fit-track/shared": "*",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.10"
    }
}
