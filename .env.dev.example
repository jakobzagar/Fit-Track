# PostgreSQL container
POSTGRES_USER=fit_track_dev
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=fit_track_dev
POSTGRES_PORT=5433

# Backend container
JWT_SECRET=replace-with-a-development-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
LOG_LEVEL=debug
# Vite is the single trusted proxy between the browser and backend.
TRUST_PROXY_HOPS=1
BACKEND_PORT=3001

# Frontend container and Vite development proxy
VITE_API_URL=/api
API_PROXY_TARGET=http://backend:3001
FRONTEND_PORT=5173

# Optional pgAdmin tools profile
PGADMIN_EMAIL=admin@fittrack.local
PGADMIN_PASSWORD=replace-with-a-local-pgadmin-password
PGADMIN_PORT=5050
